# ollama (default) or xai
STATBANK_LLM=ollama
STATBANK_BASE_URL=http://127.0.0.1:11434/v1
STATBANK_MODEL=qwen2.5

# xAI instead:
# STATBANK_LLM=xai
# STATBANK_BASE_URL=https://api.x.ai/v1
# STATBANK_MODEL=grok-4
# XAI_API_KEY=

STATBANK_HOST=127.0.0.1
STATBANK_PORT=8080
STATBANK_DAILY_CAP=200
STATBANK_RATE_PER_MINUTE=30
STATBANK_MAX_QUESTION_CHARS=1000
STATBANK_MAX_TOOL_CALLS=8
# One model reply, then one Statistikbanken call. They fail separately.
STATBANK_LLM_TIMEOUT=45
STATBANK_TOOL_TIMEOUT=30
